# Cloudflare Pages headers (copied into dist/ by Vite at build time).
# Only medschoolzone.com course pages (and the ClickFunnels editor/preview) may frame the atlas.

/*
  Content-Security-Policy: frame-ancestors 'self' https://medschoolzone.com https://*.medschoolzone.com https://*.myclickfunnels.com
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Robots-Tag: noindex, nofollow

# Geometry never changes between deploys; let browsers keep it for 30 days.
/models/*
  Cache-Control: public, max-age=2592000

# Vite fingerprints everything under /assets, so these can be cached for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
